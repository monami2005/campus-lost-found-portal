# ── Application Configuration ─────────────────────
APP_NAME="Campus Lost & Found Portal"
APP_ENV=production
APP_DEBUG=false
# APP_KEY is required for encryption. In Railway, generate one using 'php artisan key:generate --show'
# and set it as APP_KEY. Do not leave this blank in production.
APP_KEY=

# In Railway, APP_URL will be your public domain (e.g. https://your-app.up.railway.app)
# Railway provides a dynamic public domain. Paste it here once generated.
APP_URL=https://localhost

# ── Database Configuration ────────────────────────
# Option 1: SQLite (Default, easy setup)
# Note: SQLite data is ephemeral on Railway unless a persistent volume is attached.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Option 2: MySQL (Recommended for production, provisioned via Railway MySQL service)
# To use MySQL, uncomment these and set variables in Railway.
# DB_CONNECTION=mysql
# DB_HOST=${{MYSQLHOST}}
# DB_PORT=${{MYSQLPORT}}
# DB_DATABASE=${{MYSQLDATABASE}}
# DB_USERNAME=${{MYSQLUSER}}
# DB_PASSWORD=${{MYSQLPASSWORD}}

# ── Cache, Session & Queue ────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
# session driver 'file' is recommended for stateless/cookie sessions in production.
# Avoid using 'array' in production since sessions won't persist across requests.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Mail Configuration ────────────────────────────
# Set mailer to "log" for debugging, or configure "smtp" for active emailing.
MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@campus.edu"
MAIL_FROM_NAME="${APP_NAME}"
