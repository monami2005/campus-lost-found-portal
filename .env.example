APP_NAME=CampusLostAndFound
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Database ──────────────────────────────────────
# SQLite (default — zero configuration)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL (uncomment below and comment-out SQLite lines above)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=campus_lost_found
# DB_USERNAME=root
# DB_PASSWORD=

# ── Cache & Session ───────────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Mail ──────────────────────────────────────────
# Use "log" for local development, "smtp" for production
MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@campus.edu"
MAIL_FROM_NAME="${APP_NAME}"
